// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?   
  username     String   @unique
  googleId     String?  @unique 
  githubId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// AES-256-GCM encrypted TOTP secret; set but unused until `totpEnabled`.
  totpSecretEnc     String?
  totpEnabled       Boolean   @default(false)
  /// Last accepted TOTP time step, so a code cannot be replayed.
  totpLastUsedStep  Int?
  mfaFailedAttempts Int       @default(0)
  mfaLockedUntil    DateTime?

  recoveryCodes      RecoveryCode[]
  passkeys           Passkey[]
  webAuthnChallenges WebAuthnChallenge[]

  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")
}

model RecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the code; codes are high-entropy random, so no salt is needed.
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

/// A WebAuthn credential that signs the user in without a password or 2FA code.
model Passkey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base64url credential ID, as the authenticator reports it.
  credentialId String    @unique
  /// COSE-encoded public key.
  publicKey    Bytes
  /// Signature counter; a value that goes backwards hints at a cloned key.
  counter      Int
  transports   String[]
  /// "singleDevice" or "multiDevice" (synced, e.g. iCloud Keychain).
  deviceType   String
  backedUp     Boolean
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Single-use WebAuthn challenge. `userId` is set for registration ceremonies
/// and null for passwordless sign-in, where the user is not known yet.
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  challenge String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model Game {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whitePlayerId String?
  whitePlayer   User?   @relation("WhitePlayer", fields: [whitePlayerId], references: [id])

  blackPlayerId String?
  blackPlayer   User?   @relation("BlackPlayer", fields: [blackPlayerId], references: [id])

  status GameStatus @default(IN_PROGRESS)

  winnerId String?

  boardStateJson String @default("[]")

  moves Move[]
}

model Move {
  id     String @id @default(uuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  turnNumber Int

  fromPosition String
  toPosition   String

  playerId String?

  createdAt DateTime @default(now())

  @@unique([gameId, turnNumber])
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
  DRAW
  ABANDONED
}
