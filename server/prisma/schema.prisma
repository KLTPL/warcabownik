// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?   
  username     String   @unique
  googleId     String?  @unique 
  githubId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// AES-256-GCM encrypted TOTP secret; set but unused until `totpEnabled`.
  totpSecretEnc     String?
  totpEnabled       Boolean   @default(false)
  /// Last accepted TOTP time step, so a code cannot be replayed.
  totpLastUsedStep  Int?
  mfaFailedAttempts Int       @default(0)
  mfaLockedUntil    DateTime?

  recoveryCodes RecoveryCode[]

  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")
}

model RecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the code; codes are high-entropy random, so no salt is needed.
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

model Game {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whitePlayerId String?
  whitePlayer   User?   @relation("WhitePlayer", fields: [whitePlayerId], references: [id])

  blackPlayerId String?
  blackPlayer   User?   @relation("BlackPlayer", fields: [blackPlayerId], references: [id])

  status GameStatus @default(IN_PROGRESS)

  winnerId String?

  boardStateJson String @default("[]")

  moves Move[]
}

model Move {
  id     String @id @default(uuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  turnNumber Int

  fromPosition String
  toPosition   String

  playerId String?

  createdAt DateTime @default(now())

  @@unique([gameId, turnNumber])
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
  DRAW
  ABANDONED
}
